# This example runs with ZERO config — you do NOT need this file to start.
# On first load the server mints a sandbox shop for you (one unauthenticated
# call) and caches it for the process lifetime, so a fresh clone renders
# immediately. Copy this to `.env.local` only if you want to override defaults.

# --- Public (safe in the browser) ---
# OPTIONAL. Your own publishable shop id (= shop.id, like Stripe's pk_), once
# you've claimed a sandbox shop and want renders to land in YOUR shop. Leave it
# unset and the server mints a throwaway sandbox shop on boot. Do NOT commit a
# real id.
# NEXT_PUBLIC_SNOWCONE_SHOP=shop_xxx

# The demo defaults to BEEB77 and reads mockupId, placement, and variantId from
# the live catalog at runtime. Override only when you want to pin a selection.
# NEXT_PUBLIC_SNOWCONE_PRODUCT_ID=BEEB77
# NEXT_PUBLIC_SNOWCONE_MOCKUP_ID=FV1qjO
# NEXT_PUBLIC_SNOWCONE_PLACEMENT=Front
# NEXT_PUBLIC_SNOWCONE_VARIANT_ID=Pv1sLC

# --- Server only (NEVER exposed to the browser) ---
# OPTIONAL. For a PRODUCTION shop: a secret API key (sk_...) with the
# `mockups:realtime` scope. It bills your account, so it only ever lives on the
# server (the /api/realtime/grant route), never the client. Sandbox shops need
# no key (keyless publishable path).
# SNOWCONE_API_KEY=sk_xxx
# OPTIONAL. Point minting + grants at a non-prod backend. Defaults to
# https://api.snowcone.app
# SNOWCONE_API_BASE=https://api.snowcone.app
